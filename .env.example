# Server-side only. Use the pooled Neon connection string in Vercel.
DATABASE_URL=

# Optional. If omitted, Bevakly uses its seeded default organization.
BEVAKLY_ORGANIZATION_ID=

# Valfritt. Standard: buyer-country = SWE AND classification-cpv = 905*
TED_EXPERT_QUERY=

# Blind Spots: jämför faktisk historik mot det ni uttryckligen bevakar.
# Exempel: Regelverk,Teknik,Investering
BEVAKLY_WATCH_TOPICS=
# Exempel: PreZero,Ragn-Sells,Stena Recycling
BEVAKLY_WATCH_COMPETITORS=
